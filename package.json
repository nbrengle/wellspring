{
  "name": "wellspring",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "parse": "tsx scripts/parse-megadoc.js && tsx scripts/parse-archetypes.js",
    "link": "tsx scripts/link-refs.js",
    "check:data": "tsx scripts/check-data-drift.mjs",
    "link:audit": "tsx scripts/linker/link-audit.js",
    "doc:feedback": "tsx scripts/linker/doc-feedback.js",
    "test": "tsx ./scripts/test.mjs && tsx ./scripts/test-rules-enforcement.mjs && tsx ./scripts/test-browser.mjs",
    "shot": "tsx scripts/debug/shot.mjs",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint '**/*.css'",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}
